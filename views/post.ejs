<!DOCTYPE html>
<html>
<%- include("head.ejs") %>

	<body>
		<%- include("header.ejs") %>
		<%- include("modal.ejs") %>
		<div class="wrapper">
		<% posts.forEach(post=> { %>
			<div class="post">
				<h2>
					<%= post.title %>
				</h2>
				<p>
					<%= post.description %>
				</p>
				<div class="images">
					<% post.image.forEach(image => { %>
						<img src="<%=i %>">
					<% }) %>
				<img src="/uploads/<%= post.image ? post.image[0] : '' %>" alt="">
			</div>
			<% }) %>
		</div>
		<button class="open">+</button>
		<main class="post">
			<%= post.title %>
		</main>
		<%- include("footer.ejs") %>
	</body>

</html>